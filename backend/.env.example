# Copia este archivo como .env y completa tu clave de la API de Claude
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado por el agente
CLAUDE_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- Base de datos PostgreSQL
# scripts/postgres.ps1 instalar (o asegurar) escribe solas estas variables.
# Usuario de la app: solo lee y escribe datos (no puede crear, cambiar ni borrar tablas)
DATABASE_URL=postgresql://proyectochats_app:CONTRASEÑA@localhost:5432/proyectochats
# Usuario dueño del esquema: solo para aplicar las migraciones (backend/database/migrations)
DATABASE_ADMIN_URL=postgresql://proyectochats:CONTRASEÑA@localhost:5432/proyectochats
# Aplicar las migraciones pendientes al arrancar. Con false, la app solo comprueba que el esquema está al día
# (en producción: migrar con `python -m app.manage migrate` y quitar DATABASE_ADMIN_URL del servidor)
DB_AUTO_MIGRATE=true
# Cifrado: verify-full comprueba el certificado del servidor con el de su autoridad (DB_SSLROOTCERT).
# Vacío = automático: verify-full si la base de datos está en otro equipo (nunca se permite sin cifrar).
DB_SSLMODE=verify-full
DB_SSLROOTCERT=C:/Users/USUARIO/PostgreSQL/certs/ca.crt
# Tiempos límite: conectar (segundos) y cada consulta (milisegundos); tamaño del pool de conexiones
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_SIZE=10
# Bases de datos para las pruebas automáticas: se VACÍAN en cada ejecución; su nombre debe contener "test"
TEST_DATABASE_URL=postgresql://proyectochats_app:CONTRASEÑA@localhost:5432/proyectochats_test
TEST_DATABASE_ADMIN_URL=postgresql://proyectochats:CONTRASEÑA@localhost:5432/proyectochats_test
# Carpeta de archivos (adjuntos y clave de cifrado)
DATA_DIR=data

# ---------------------------------------------------------------- Servidor (python -m app.serve)
HOST=127.0.0.1
PORT=8000
# HTTPS directo (sin proxy): rutas al certificado y su clave
# SSL_CERTFILE=certs/cert.pem
# SSL_KEYFILE=certs/key.pem
# Detrás de un proxy (Caddy/Nginx en la misma máquina): IPs del proxy de confianza
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------- Seguridad
# En producción (servida por HTTPS) pon las dos a true
FORCE_HTTPS=false
COOKIE_SECURE=false
# Bloqueo tras intentos fallidos de inicio de sesión
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_MAX_FAILS_PER_IP=20
# Documentación interactiva de la API en /docs (solo para desarrollo)
ENABLE_DOCS=false

# ---------------------------------------------------------------- Integraciones (email, Telegram, WhatsApp)
# Clave para cifrar contraseñas y tokens de las integraciones. Si se deja vacía se genera una en
# data/secret.key. Si la cambias o la pierdes, habrá que volver a introducir las credenciales.
# Generar una: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# Sincronización periódica de buzones y bots (true = desactivada)
DISABLE_SYNC=false
